  "candidate": {
    "protocol": "scored_path_order_candidate/v1",
    "version": 1,
    "description": "Ranks compact, peripheral parts higher using extent ratio times center distance, discounted by volume share; mildly penalizes fragmentation and isolated remainders. Motivated by same-state B chains where side-part-first runs had lower peak holds than the thin-part-first run. This does not establish first-choice causality or improvement elsewhere; real physics validation is required.",
    "evidence_ids": [
      "obs_d5db398b00943717",
      "obs_5aa1531b10fbe47e",
      "obs_9058a7addc555580"
    ],
    "name": "Compact peripheral removal with fragmentation discount",
    "source": "def propose(ctx):\n    shape = ctx.get(\"shortest_over_longest_extent\")\n    distance = ctx.get(\"distance_from_center_over_diagonal\")\n    volume = ctx.get(\"volume_fraction_if_valid\")\n    if shape is None:\n        shape = 0.5\n    if distance is None:\n        distance = 0.0\n    if volume is None:\n        volume = 0.0\n    shape = min(1.0, max(0.0, shape))\n    distance = min(1.0, max(0.0, distance))\n    volume = min(1.0, max(0.0, volume))\n    geometry = shape * distance / (1.0 + volume)\n    fragmentation = max(0, ctx[\"component_delta\"])\n    isolation = ctx[\"remainder_isolated_nodes\"] / max(1, ctx[\"parent_count\"] - 1)\n    return round(geometry - 0.1 * fragmentation - 0.1 * isolation, 6)",
    "source_sha256": "999d05471052a49570bc230f2541b063f45887e2fb294920f5b3fed7ffdfffd2",
    "packet_sha256": "a9349b8569d815674e76a61ea15b3aa119b6682df1e72163048c42fd1c1eb3f9",
